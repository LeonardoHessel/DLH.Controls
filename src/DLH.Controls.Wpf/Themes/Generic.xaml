<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:DLH.Controls.Wpf">
    <SolidColorBrush x:Key="Tabs.Surface" Color="#35373C" />
    <SolidColorBrush x:Key="Tabs.Idle" Color="Transparent" />
    <SolidColorBrush x:Key="Tabs.Hover" Color="#454850" />
    <SolidColorBrush x:Key="Tabs.Text" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Tabs.Muted" Color="#BCC0CA" />
    <SolidColorBrush x:Key="Tabs.Edge" Color="#4C5058" />
    <SolidColorBrush x:Key="Tabs.Focus" Color="#9CC9FF" />
    <SolidColorBrush x:Key="DataGridView.Surface" Color="#35373C" />
    <SolidColorBrush x:Key="DataGridView.Header" Color="#2F3136" />
    <SolidColorBrush x:Key="DataGridView.Hover" Color="#454850" />
    <SolidColorBrush x:Key="DataGridView.Selection" Color="#334F8AC9" />
    <SolidColorBrush x:Key="DataGridView.Text" Color="#F2F3F5" />
    <SolidColorBrush x:Key="DataGridView.Edge" Color="#4C5058" />
    <SolidColorBrush x:Key="DataGridView.Focus" Color="#9CC9FF" />
    <SolidColorBrush x:Key="DataGridView.Muted" Color="#B7BBC4" />
    <SolidColorBrush x:Key="DataGridView.Stripe" Color="#24373A40" />
    <SolidColorBrush x:Key="DataGridView.Error" Color="#FF7777" />
    <SolidColorBrush x:Key="ContextMenu.Surface" Color="#35373C" />
    <SolidColorBrush x:Key="ContextMenu.Text" Color="#F2F3F5" />
    <SolidColorBrush x:Key="ContextMenu.Edge" Color="#4C5058" />
    <SolidColorBrush x:Key="ContextMenu.Hover" Color="#454850" />
    <SolidColorBrush x:Key="ContextMenu.Checked" Color="#9CC9FF" />
    <SolidColorBrush x:Key="ContextMenu.Separator" Color="#4C5058" />
    <sys:Double x:Key="ContextMenu.DisabledOpacity">0.45</sys:Double>
    <sys:Double x:Key="ContextMenu.IconSize">16</sys:Double>
    <GridLength x:Key="ContextMenu.IconColumnWidth">26</GridLength>
    <Thickness x:Key="ContextMenu.ItemPadding">10,7,10,7</Thickness>
    <Thickness x:Key="ContextMenu.Padding">4</Thickness>
    <Thickness x:Key="ContextMenu.BorderThickness">1</Thickness>
    <CornerRadius x:Key="ContextMenu.CornerRadius">8</CornerRadius>
    <local:TabCloseAutomationNameConverter x:Key="Tabs.CloseAutomationNameConverter" />
    <local:DataGridViewColumnSelectionConverter x:Key="DataGridView.ColumnSelectionConverter" />
    <local:HalfValueToCornerRadiusConverter x:Key="DataGridView.HalfCornerRadiusConverter" />
    <local:ScrollBarCornerRadiusConverter x:Key="ScrollBar.CornerRadiusConverter" />
    <Thickness x:Key="Tabs.HeaderPadding">22,13,22,13</Thickness>

    <Style x:Key="ScrollBar.LineButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Foreground" Value="{Binding ThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{Binding TrackBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{Binding ThumbPressedBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContextMenu.ItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource ContextMenu.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="{DynamicResource ContextMenu.ItemPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="4"/>
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{DynamicResource ContextMenu.IconColumnWidth}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon"
                                              Width="{DynamicResource ContextMenu.IconSize}"
                                              Height="{DynamicResource ContextMenu.IconSize}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CheckMark" Grid.Column="0" Text="✓" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ContextMenu.Checked}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Margin="18,0,4,0" Text="{TemplateBinding InputGestureText}"
                                       Opacity=".65" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SubmenuArrow" Grid.Column="3" Text="›" FontSize="16"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right" HorizontalOffset="-3">
                            <Border Background="{DynamicResource ContextMenu.Surface}"
                                    BorderBrush="{DynamicResource ContextMenu.Edge}"
                                    BorderThickness="{DynamicResource ContextMenu.BorderThickness}"
                                    CornerRadius="{DynamicResource ContextMenu.CornerRadius}" Padding="{DynamicResource ContextMenu.Padding}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ContextMenu.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource ContextMenu.DisabledOpacity}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="Icon" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ContextMenu.SeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border x:Name="SeparatorLine" Height="1" Margin="8,4" Background="{DynamicResource ContextMenu.Separator}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource ContextMenu.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource ContextMenu.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenu.Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ContextMenu}">
                    <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect Color="{TemplateBinding ShadowColor}" Opacity="{TemplateBinding ShadowOpacity}"
                                              BlurRadius="{TemplateBinding ShadowBlurRadius}" ShadowDepth="{TemplateBinding ShadowDepth}"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsShadowEnabled" Value="False"><Setter TargetName="MenuSurface" Property="Effect" Value="{x:Null}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource ContextMenu.ItemStyle}"/>
            <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource ContextMenu.SeparatorStyle}"/>
        </Style.Resources>
    </Style>

    <ControlTemplate x:Key="ScrollBar.VerticalTemplate" TargetType="{x:Type local:ScrollBar}">
        <Grid Width="{TemplateBinding Thickness}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <RepeatButton x:Name="DecreaseButton" Style="{StaticResource ScrollBar.LineButtonStyle}" Command="ScrollBar.LineUpCommand" Content="▲" FontSize="8" />
            <Border x:Name="TrackSurface" Grid.Row="1" Background="{TemplateBinding TrackBrush}" Padding="{TemplateBinding TrackPadding}">
                <Border.CornerRadius><MultiBinding Converter="{StaticResource ScrollBar.CornerRadiusConverter}"><Binding Path="CornerRadius" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/></MultiBinding></Border.CornerRadius>
                <Border.Effect><DropShadowEffect Color="{Binding ShadowColor, RelativeSource={RelativeSource TemplatedParent}}" Opacity="{Binding ShadowOpacity, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="{Binding ShadowBlurRadius, RelativeSource={RelativeSource TemplatedParent}}" ShadowDepth="{Binding ShadowDepth, RelativeSource={RelativeSource TemplatedParent}}"/></Border.Effect>
                <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="{Binding ThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}" Opacity="{Binding ThumbOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"><Border.CornerRadius><MultiBinding Converter="{StaticResource ScrollBar.CornerRadiusConverter}"><Binding Path="CornerRadius" RelativeSource="{RelativeSource AncestorType={x:Type local:ScrollBar}}"/><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/></MultiBinding></Border.CornerRadius></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{Binding ThumbHoverBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{Binding ThumbPressedBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                </Track>
            </Border>
            <RepeatButton x:Name="IncreaseButton" Grid.Row="2" Style="{StaticResource ScrollBar.LineButtonStyle}" Command="ScrollBar.LineDownCommand" Content="▼" FontSize="8" />
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="ShowButtons" Value="False"><Setter TargetName="DecreaseButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="IncreaseButton" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsShadowEnabled" Value="False"><Setter TargetName="TrackSurface" Property="Effect" Value="{x:Null}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ScrollBar.HorizontalTemplate" TargetType="{x:Type local:ScrollBar}">
        <Grid Height="{TemplateBinding Thickness}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <RepeatButton x:Name="DecreaseButton" Style="{StaticResource ScrollBar.LineButtonStyle}" Command="ScrollBar.LineLeftCommand" Content="◀" FontSize="8" />
            <Border x:Name="TrackSurface" Grid.Column="1" Background="{TemplateBinding TrackBrush}" Padding="{TemplateBinding TrackPadding}">
                <Border.CornerRadius><MultiBinding Converter="{StaticResource ScrollBar.CornerRadiusConverter}"><Binding Path="CornerRadius" RelativeSource="{RelativeSource TemplatedParent}"/><Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/></MultiBinding></Border.CornerRadius>
                <Border.Effect><DropShadowEffect Color="{Binding ShadowColor, RelativeSource={RelativeSource TemplatedParent}}" Opacity="{Binding ShadowOpacity, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="{Binding ShadowBlurRadius, RelativeSource={RelativeSource TemplatedParent}}" ShadowDepth="{Binding ShadowDepth, RelativeSource={RelativeSource TemplatedParent}}"/></Border.Effect>
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="{Binding ThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}" Opacity="{Binding ThumbOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"><Border.CornerRadius><MultiBinding Converter="{StaticResource ScrollBar.CornerRadiusConverter}"><Binding Path="CornerRadius" RelativeSource="{RelativeSource AncestorType={x:Type local:ScrollBar}}"/><Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/></MultiBinding></Border.CornerRadius></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{Binding ThumbHoverBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="{Binding ThumbPressedBrush, RelativeSource={RelativeSource AncestorType={x:Type local:ScrollBar}}}"/><Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                </Track>
            </Border>
            <RepeatButton x:Name="IncreaseButton" Grid.Column="2" Style="{StaticResource ScrollBar.LineButtonStyle}" Command="ScrollBar.LineRightCommand" Content="▶" FontSize="8" />
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="ShowButtons" Value="False"><Setter TargetName="DecreaseButton" Property="Visibility" Value="Collapsed"/><Setter TargetName="IncreaseButton" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsShadowEnabled" Value="False"><Setter TargetName="TrackSurface" Property="Effect" Value="{x:Null}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:ScrollBar}">
        <Setter Property="Focusable" Value="False"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template" Value="{StaticResource ScrollBar.VerticalTemplate}"/>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Template" Value="{StaticResource ScrollBar.HorizontalTemplate}"/></Trigger></Style.Triggers>
    </Style>

    <Style x:Key="Tabs.ItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Tabs.Muted}" />
        <Setter Property="Background" Value="{DynamicResource Tabs.Idle}" />
        <Setter Property="Padding" Value="{DynamicResource Tabs.HeaderPadding}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border Margin="5" BorderThickness="1" CornerRadius="5"
                                        BorderBrush="{DynamicResource Tabs.Focus}" IsHitTestVisible="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Grid.Margin>
                            <MultiBinding Converter="{x:Static local:TabSpacingConverter.Instance}"><Binding Path="TabSpacing" RelativeSource="{RelativeSource AncestorType={x:Type local:TabControl}}" /><Binding Path="TabStripPlacement" RelativeSource="{RelativeSource AncestorType={x:Type local:TabControl}}" /></MultiBinding>
                        </Grid.Margin>
                        <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="CloseButton" DockPanel.Dock="Right" Margin="10,0,0,0" Width="20" Height="20"
                                        Command="{x:Static local:TabControl.CloseTab}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTip="Fechar aba" Visibility="Collapsed"
                                        Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0">
                                    <AutomationProperties.Name>
                                        <MultiBinding Converter="{StaticResource Tabs.CloseAutomationNameConverter}">
                                            <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource AncestorType={x:Type TabItem}}" />
                                            <Binding Path="Header" RelativeSource="{RelativeSource AncestorType={x:Type TabItem}}" />
                                        </MultiBinding>
                                    </AutomationProperties.Name>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseSurface" CornerRadius="3" Background="{TemplateBinding Background}">
                                                <Path Data="M 6,6 L 14,14 M 14,6 L 6,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource Tabs.Hover}" /></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CloseSurface" Property="Opacity" Value="0.35" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Grid>
                                    <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <TextBox x:Name="HeaderEditor" Visibility="Collapsed" MinWidth="48"
                                             VerticalContentAlignment="Center" Padding="4,1"
                                             AutomationProperties.Name="Editar nome da aba"
                                             Foreground="{DynamicResource Tabs.Text}" Background="{DynamicResource Tabs.Surface}"
                                             BorderBrush="{DynamicResource Tabs.Focus}" BorderThickness="1" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanCloseTabs, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" Value="True" />
                                <Condition Binding="{Binding ShowCloseButtons, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" Value="True" />
                                <Condition Binding="{Binding Path=(local:TabControl.CanCloseTab), RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter Property="Foreground" Value="{DynamicResource Tabs.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource Tabs.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:TabControlItem}" BasedOn="{StaticResource Tabs.ItemStyle}" />
    <Style TargetType="{x:Type local:TabControl}">
        <Setter Property="Background" Value="{DynamicResource Tabs.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Tabs.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tabs.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Tabs.ItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TabControl}">
                    <Grid x:Name="PART_Layout" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- O contorno contínuo com junções curvas desenha fundo, borda e sombra uma única vez. -->
                        <Canvas Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
                            <Path x:Name="PART_HoverSurface" Fill="{DynamicResource Tabs.Hover}" />
                            <Path x:Name="PART_Surface" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}">
                                                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    Color="{Binding ShadowColor, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"
                                                    BlurRadius="{Binding ShadowBlurRadius, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"
                                                    ShadowDepth="{Binding ShadowDepth, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"
                                                    Direction="{Binding ShadowDirection, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"
                                                    Opacity="{Binding ShadowOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShadowEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" Value="False">
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Canvas>
                        <ScrollViewer x:Name="PART_HeaderScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" Focusable="False" Margin="12,0,12,0">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <!-- A rolagem fica acima das abas, preservando o contato com o corpo. -->
                                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.Column="1" CanContentScroll="False" />
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <StackPanel x:Name="PART_HeaderFlow" Orientation="Horizontal">
                                <StackPanel x:Name="PART_HeaderPanel" IsItemsHost="True" Orientation="Horizontal" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once" />
                                <Button x:Name="PART_AddTabButton"
                                        MinWidth="38" MinHeight="38" Padding="10,6" Margin="2,0,0,0"
                                        Content="{TemplateBinding AddTabContent}"
                                        ContentTemplate="{TemplateBinding AddTabContentTemplate}"
                                        Command="{x:Static local:TabControl.AddTab}"
                                        CommandParameter="{TemplateBinding AddTabCommandParameter}"
                                        AutomationProperties.Name="Adicionar aba" ToolTip="Adicionar aba"
                                        Foreground="{TemplateBinding Foreground}" Background="Transparent"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="AddSurface" Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddSurface" Property="Background" Value="{DynamicResource Tabs.Hover}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AddSurface" Property="BorderBrush" Value="{DynamicResource Tabs.Focus}" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="AddSurface" Property="Opacity" Value="0.72" /></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="AddSurface" Property="Opacity" Value="0.35" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanAddTabs, RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Canvas x:Name="PART_DragPreviewLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="10" IsHitTestVisible="False"><Line x:Name="PART_DropIndicator" Stroke="{DynamicResource Tabs.Focus}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" /></Canvas>
                        <Border x:Name="PART_Body" Grid.Row="1" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="{TemplateBinding Padding}" KeyboardNavigation.TabNavigation="Local">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:DataGridView}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{DynamicResource DataGridView.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource DataGridView.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DataGridView.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridView.Edge}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DataGridView}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid x:Name="PART_ClipRoot">
                            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Grid.ColumnSpan="2"
                                                    Background="{DynamicResource DataGridView.Header}"
                                                    BorderBrush="{DynamicResource DataGridView.Edge}"
                                                    BorderThickness="0,0,0,1" />
                                            <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                Grid.Row="0" Grid.ColumnSpan="2" />
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="1" Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            <local:ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Panel.ZIndex="5"
                                                Margin="0,6,6,6" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}"
                                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                Thickness="{Binding ScrollBarThickness, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                TrackBrush="{Binding ScrollBarTrackBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                ThumbBrush="{Binding ScrollBarThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                ThumbHoverBrush="{Binding ScrollBarThumbHoverBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                            <local:ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Grid.ColumnSpan="2" Panel.ZIndex="6"
                                                Margin="6,0,6,6" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}"
                                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                Thickness="{Binding ScrollBarThickness, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                TrackBrush="{Binding ScrollBarTrackBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                ThumbBrush="{Binding ScrollBarThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                ThumbHoverBrush="{Binding ScrollBarThumbHoverBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                            <Border x:Name="EmptyState" Margin="1,35,1,1" Padding="24" Background="{TemplateBinding Background}"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DataGridView.Muted}"
                                           Text="{TemplateBinding EmptyMessage}" TextWrapping="Wrap" />
                            </Border>
                            <Border x:Name="LoadingState" Margin="1,35,1,1" Padding="24" Background="{TemplateBinding Background}"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="120" Height="3" IsIndeterminate="True" />
                                    <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DataGridView.Muted}"
                                               Text="{TemplateBinding LoadingMessage}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ErrorState" Margin="1,35,1,1" Padding="24" Background="{TemplateBinding Background}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DataGridView.Error}"
                                           Text="{TemplateBinding ErrorMessage}" TextWrapping="Wrap" />
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                            <Trigger Property="Tag" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Tag><Binding Path="ErrorMessage" RelativeSource="{RelativeSource TemplatedParent}" /></Border.Tag>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False"><Setter TargetName="EmptyState" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsLoading" Value="True"><Setter TargetName="EmptyState" Property="Visibility" Value="Collapsed" /><Setter TargetName="LoadingState" Property="Visibility" Value="Visible" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource DataGridView.Header}" />
                    <Setter Property="Foreground" Value="{DynamicResource DataGridView.Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DataGridView.Edge}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="SortPriority" Margin="0,0,3,0" VerticalAlignment="Center"
                                                           Foreground="{Binding ActiveSortIconBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Text="{Binding Column.(local:DataGridView.SortPriority), RelativeSource={RelativeSource TemplatedParent}}" />
                                                <Path x:Name="SortIndicator"
                                                      Width="{Binding SortIconSize, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                      Height="{Binding SortIconSize, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                      Data="{Binding UnsortedIcon, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                      Stroke="{Binding SortIconBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}"
                                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      Stretch="Uniform" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        </DockPanel>
                                    </Border>
                                    <Thumb x:Name="PART_LeftHeaderGripper" Width="8" HorizontalAlignment="Left" Background="Transparent">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                    <Thumb x:Name="PART_RightHeaderGripper" Width="8" HorizontalAlignment="Right" Background="Transparent">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Column.CanUserSort, RelativeSource={RelativeSource Self}}" Value="False">
                                        <Setter TargetName="SortIndicator" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowSortIndicators, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" Value="False">
                                        <Setter TargetName="SortIndicator" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanUserSortColumns, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" Value="False">
                                        <Setter TargetName="SortIndicator" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Column.(local:DataGridView.SortPriority), RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter TargetName="SortPriority" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter TargetName="SortIndicator" Property="Data" Value="{Binding AscendingSortIcon, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" />
                                        <Setter TargetName="SortIndicator" Property="Stroke" Value="{Binding ActiveSortIconBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" />
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter TargetName="SortIndicator" Property="Data" Value="{Binding DescendingSortIcon, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" />
                                        <Setter TargetName="SortIndicator" Property="Stroke" Value="{Binding ActiveSortIconBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DataGridView.Text}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource DataGridView.ColumnSelectionConverter}">
                                    <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="SelectedColumn" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGridView}}" />
                                    <Binding Path="SelectionBehavior" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGridView}}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="{DynamicResource DataGridView.Selection}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource DataGridView.Text}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource DataGridView.Stripe}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource DataGridView.Hover}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource DataGridView.Selection}" /></Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource DataGridView.Text}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border x:Name="CellSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{Binding CellPadding, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="CellSurface" Property="Background" Value="{DynamicResource DataGridView.Selection}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CellSurface" Property="BorderBrush" Value="{DynamicResource DataGridView.Focus}" /><Setter TargetName="CellSurface" Property="BorderThickness" Value="1" /></Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Path=(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding ShowValidationErrors, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="CellSurface" Property="BorderBrush" Value="{Binding ValidationErrorBrush, RelativeSource={RelativeSource AncestorType={x:Type local:DataGridView}}}" />
                                        <Setter TargetName="CellSurface" Property="BorderThickness" Value="1" />
                                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource DataGridView.ColumnSelectionConverter}">
                                    <Binding Path="Column" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="SelectedColumn" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGridView}}" />
                                    <Binding Path="SelectionBehavior" RelativeSource="{RelativeSource AncestorType={x:Type local:DataGridView}}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Background" Value="{DynamicResource DataGridView.Selection}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

