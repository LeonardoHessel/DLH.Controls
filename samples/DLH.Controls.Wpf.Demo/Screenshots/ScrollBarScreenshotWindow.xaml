<Window x:Class="DLH.Controls.Wpf.Demo.Screenshots.ScrollBarScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        Title="ScrollBar" Width="1000" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1C1D20" Foreground="#ECEEF2"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#292B2F"/>
            <Setter Property="BorderBrush" Value="#45484F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB3BD"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Vertical, botões direcionais e sombra"/>
                <Grid Height="440">
                    <controls:ScrollBar Orientation="Vertical" Thickness="14" CornerRadius="7"
                                         Minimum="0" Maximum="100" Value="30" ViewportSize="24"
                                         ShowButtons="True" IsShadowEnabled="True"
                                         TrackBrush="#2A2D32" ThumbBrush="#42A5E8" ThumbHoverBrush="#5BB4F0"
                                         HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Horizontal, sem botões, raio reduzido"/>
                <controls:ScrollBar Orientation="Horizontal" Thickness="10" CornerRadius="3"
                                     Minimum="0" Maximum="100" Value="55" ViewportSize="30"
                                     ShowButtons="False"
                                     TrackBrush="#2A2D32" ThumbBrush="#7EDC9A" ThumbHoverBrush="#94E8AC"
                                     VerticalAlignment="Top" Margin="0,0,0,40"/>
                <TextBlock Style="{StaticResource Label}" Margin="0,0,0,14" Text="Vertical, raio total, cor de destaque"/>
                <Grid Height="300">
                    <controls:ScrollBar Orientation="Vertical" Thickness="18" CornerRadius="9"
                                         Minimum="0" Maximum="100" Value="70" ViewportSize="18"
                                         ShowButtons="True"
                                         TrackBrush="#2A2D32" ThumbBrush="#E8A542" ThumbHoverBrush="#F0B75B"
                                         HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
