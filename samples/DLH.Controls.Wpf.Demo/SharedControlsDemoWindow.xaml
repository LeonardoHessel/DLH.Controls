<Window x:Class="DLH.Controls.Wpf.Demo.SharedControlsDemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        Title="DLH Controls · ScrollBar e ContextMenu" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#1C1D20" Foreground="#ECEEF2" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="Padding" Value="12"/><Setter Property="Foreground" Value="#DDE0E6"/><Setter Property="BorderBrush" Value="#45484F"/></Style>
            <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
            <Style TargetType="TextBox"><Setter Property="Margin" Value="6,3"/><Setter Property="Padding" Value="6,4"/><Setter Property="Background" Value="#292B2F"/><Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="BorderBrush" Value="#50545C"/></Style>
            <Style TargetType="CheckBox"><Setter Property="Margin" Value="6,5"/><Setter Property="Foreground" Value="#D6D8DE"/></Style>
            <Style TargetType="Slider"><Setter Property="Margin" Value="6,3"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="AutoToolTipPlacement" Value="TopLeft"/><Setter Property="AutoToolTipPrecision" Value="2"/></Style>
            <Style TargetType="Button"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#34373D"/><Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="BorderBrush" Value="#50545C"/></Style>
            <Style x:Key="ColorPickerButton" TargetType="Button"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,3"/><Setter Property="Content" Value="●"/><Setter Property="ToolTip" Value="Escolher cor"/></Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="CONTROLES COMPARTILHADOS" FontSize="11" Foreground="#9DA3AE"/>
            <TextBlock Text="ScrollBar e ContextMenu" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,3"/>
            <TextBlock Text="Altere as opções à direita e confira o resultado imediatamente." Foreground="#AEB3BD"/>
        </StackPanel>

        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="470"/></Grid.ColumnDefinitions>
            <Border Margin="0,0,20,0" Padding="24" Background="#292B2F" BorderBrush="#45484F" BorderThickness="1" CornerRadius="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Prévia" FontSize="18" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Background="#202226" BorderBrush="#45484F" BorderThickness="1" CornerRadius="10" Padding="22">
                            <Grid x:Name="ScrollBarPreviewHost">
                                <TextBlock Text="Área rolável de exemplo&#x0a;&#x0a;A barra preserva os comandos e o comportamento nativo do WPF.&#x0a;&#x0a;Use o mouse para alterar o valor." TextWrapping="Wrap" Foreground="#AEB3BD" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <controls:ScrollBar x:Name="DemoScrollBar" Orientation="Vertical" Minimum="0" Maximum="100" Value="35" ViewportSize="20" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Text="Abra o menu para validar foco, hover, marcação, ícone, separador, item desabilitado e submenu." TextWrapping="Wrap" Foreground="#AEB3BD" Margin="0,0,0,8"/>
                            <Button x:Name="OpenMenuButton" Content="Abrir ContextMenu" HorizontalAlignment="Left" Click="OpenMenu_Click">
                                <Button.ContextMenu>
                                    <controls:ContextMenu x:Name="DemoMenu">
                                        <MenuItem Header="Atualizar" InputGestureText="F5"><MenuItem.Icon><TextBlock Text="↻" Foreground="#42A5E8"/></MenuItem.Icon></MenuItem>
                                        <controls:ToggleMenuItem x:Name="DetailsToggleItem" Header="Exibir detalhes" IsChecked="True">
                                            <controls:ToggleMenuItem.CheckedIcon><TextBlock Text="●" Foreground="#7EDC9A"/></controls:ToggleMenuItem.CheckedIcon>
                                            <controls:ToggleMenuItem.UncheckedIcon><TextBlock Text="○" Foreground="#AEB3BD"/></controls:ToggleMenuItem.UncheckedIcon>
                                        </controls:ToggleMenuItem>
                                        <controls:ChoiceMenuItem x:Name="ThemeChoiceItem" Header="Tema" SelectedIndex="0">
                                            <controls:ChoiceMenuOption Content="Escuro" Value="Dark" Icon="☾"/>
                                            <controls:ChoiceMenuOption Content="Claro" Value="Light" Icon="☀"/>
                                            <controls:ChoiceMenuOption Content="Sistema" Value="System" Icon="◐"/>
                                        </controls:ChoiceMenuItem>
                                        <Separator/>
                                        <MenuItem Header="Exportar">
                                            <MenuItem Header="Arquivo CSV"/>
                                            <MenuItem Header="Planilha" IsEnabled="False"/>
                                        </MenuItem>
                                        <MenuItem Header="Ação indisponível" IsEnabled="False"/>
                                    </controls:ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Text="MenuItem sempre visível" FontWeight="SemiBold" Margin="6,14,6,6"/>
                            <Border x:Name="PersistentMenuSurface" Width="300" HorizontalAlignment="Left"
                                    Background="#35373C" BorderBrush="#4C5058" BorderThickness="1"
                                    CornerRadius="8" Padding="4">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="ContextMenu.Surface" Color="#35373C"/>
                                    <SolidColorBrush x:Key="ContextMenu.Text" Color="#F2F3F5"/>
                                    <SolidColorBrush x:Key="ContextMenu.Edge" Color="#4C5058"/>
                                    <SolidColorBrush x:Key="ContextMenu.Hover" Color="#454850"/>
                                    <SolidColorBrush x:Key="ContextMenu.Checked" Color="#9CC9FF"/>
                                    <SolidColorBrush x:Key="ContextMenu.Separator" Color="#4C5058"/>
                                    <sys:Double x:Key="ContextMenu.DisabledOpacity" xmlns:sys="clr-namespace:System;assembly=System.Runtime">0.45</sys:Double>
                                    <sys:Double x:Key="ContextMenu.IconSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:Double>
                                    <GridLength x:Key="ContextMenu.IconColumnWidth">26</GridLength>
                                    <Thickness x:Key="ContextMenu.ItemPadding">10,7,10,7</Thickness>
                                    <Thickness x:Key="ContextMenu.Padding">4</Thickness>
                                    <Thickness x:Key="ContextMenu.BorderThickness">1</Thickness>
                                    <CornerRadius x:Key="ContextMenu.CornerRadius">8</CornerRadius>
                                </Border.Resources>
                                <StackPanel>
                                    <MenuItem Header="Atualizar" InputGestureText="F5" Style="{StaticResource ContextMenu.ItemStyle}"><MenuItem.Icon><TextBlock Text="↻" Foreground="#42A5E8"/></MenuItem.Icon></MenuItem>
                                    <controls:ToggleMenuItem x:Name="PersistentDetailsToggleItem" Header="Exibir detalhes" IsChecked="True" Style="{StaticResource ContextMenu.ItemStyle}">
                                        <controls:ToggleMenuItem.CheckedIcon><TextBlock Text="●" Foreground="#7EDC9A"/></controls:ToggleMenuItem.CheckedIcon>
                                        <controls:ToggleMenuItem.UncheckedIcon><TextBlock Text="○" Foreground="#AEB3BD"/></controls:ToggleMenuItem.UncheckedIcon>
                                    </controls:ToggleMenuItem>
                                    <controls:ChoiceMenuItem x:Name="PersistentThemeChoiceItem" Header="Tema" SelectedIndex="0" Style="{StaticResource ContextMenu.ItemStyle}">
                                        <controls:ChoiceMenuOption Content="Escuro" Value="Dark" Icon="☾"/>
                                        <controls:ChoiceMenuOption Content="Claro" Value="Light" Icon="☀"/>
                                        <controls:ChoiceMenuOption Content="Sistema" Value="System" Icon="◐"/>
                                    </controls:ChoiceMenuItem>
                                    <Separator Style="{StaticResource ContextMenu.SeparatorStyle}"/>
                                    <MenuItem Header="Exportar" Style="{StaticResource ContextMenu.ItemStyle}">
                                        <MenuItem Header="Arquivo CSV" Style="{StaticResource ContextMenu.ItemStyle}"/>
                                        <MenuItem Header="Planilha" IsEnabled="False" Style="{StaticResource ContextMenu.ItemStyle}"/>
                                    </MenuItem>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" x:Name="ValidationMessage" Foreground="#8DCAEF" Text="Configuração padrão aplicada." TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="ScrollBar — geometria e comportamento">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Orientação"/><ComboBox x:Name="ScrollOrientation" Grid.Column="1" Margin="6,3" Padding="6" SelectedIndex="0" SelectionChanged="OptionsChanged"><ComboBoxItem Content="Vertical"/><ComboBoxItem Content="Horizontal"/></ComboBox>
                            <TextBlock Grid.Row="1" Text="Espessura"/><Slider x:Name="ScrollThickness" Grid.Row="1" Grid.Column="1" Minimum="4" Maximum="30" Value="10" ValueChanged="OptionsChanged"/>
                            <TextBlock Grid.Row="2" Text="Opacidade do polegar"/><Slider x:Name="ThumbOpacity" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="0.72" ValueChanged="OptionsChanged"/>
                            <TextBlock Grid.Row="3" Text="Valor"/><Slider x:Name="ScrollValue" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="35" ValueChanged="OptionsChanged"/>
                            <CheckBox x:Name="ScrollButtons" Grid.Row="4" Grid.ColumnSpan="2" Content="Exibir botões direcionais" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                            <CheckBox x:Name="ScrollShadow" Grid.Row="5" Grid.ColumnSpan="2" Content="Habilitar sombra" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="ScrollBar — cores, raio e sombra">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                            <TextBlock Text="CornerRadius"/><TextBox x:Name="ScrollCorner" Grid.Column="1" Text="5"/>
                            <TextBlock Grid.Row="1" Text="TrackPadding"/><TextBox x:Name="ScrollTrackPadding" Grid.Row="1" Grid.Column="1" Text="0"/>
                            <TextBlock Grid.Row="2" Text="TrackBrush"/><DockPanel Grid.Row="2" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=ScrollTrack}" Foreground="{Binding Text, ElementName=ScrollTrack}" Click="PickColor_Click"/><TextBox x:Name="ScrollTrack" Text="#3D4046"/></DockPanel>
                            <TextBlock Grid.Row="3" Text="ThumbBrush"/><DockPanel Grid.Row="3" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=ScrollThumb}" Foreground="{Binding Text, ElementName=ScrollThumb}" Click="PickColor_Click"/><TextBox x:Name="ScrollThumb" Text="#686D77"/></DockPanel>
                            <TextBlock Grid.Row="4" Text="ThumbHoverBrush"/><DockPanel Grid.Row="4" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=ScrollThumbHover}" Foreground="{Binding Text, ElementName=ScrollThumbHover}" Click="PickColor_Click"/><TextBox x:Name="ScrollThumbHover" Text="#8B919D"/></DockPanel>
                            <TextBlock Grid.Row="5" Text="ThumbPressedBrush"/><DockPanel Grid.Row="5" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=ScrollThumbPressed}" Foreground="{Binding Text, ElementName=ScrollThumbPressed}" Click="PickColor_Click"/><TextBox x:Name="ScrollThumbPressed" Text="#AEB4BF"/></DockPanel>
                            <TextBlock Grid.Row="6" Text="ShadowColor"/><DockPanel Grid.Row="6" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=ScrollShadowColor}" Foreground="{Binding Text, ElementName=ScrollShadowColor}" Click="PickColor_Click"/><TextBox x:Name="ScrollShadowColor" Text="#494949"/></DockPanel>
                            <TextBlock Grid.Row="7" Text="ShadowOpacity / Blur"/><StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal"><Slider x:Name="ScrollShadowOpacity" Width="100" Minimum="0" Maximum="1" Value="0.5" ValueChanged="OptionsChanged"/><Slider x:Name="ScrollShadowBlur" Width="100" Minimum="0" Maximum="30" Value="10" ValueChanged="OptionsChanged"/></StackPanel>
                            <TextBlock Grid.Row="8" Text="ShadowDepth"/><Slider x:Name="ScrollShadowDepth" Grid.Row="8" Grid.Column="1" Minimum="-15" Maximum="15" Value="0" ValueChanged="OptionsChanged"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="ContextMenu — geometria e estados">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                            <TextBlock Text="CornerRadius"/><TextBox x:Name="MenuCorner" Grid.Column="1" Text="8"/>
                            <TextBlock Grid.Row="1" Text="Padding"/><TextBox x:Name="MenuPadding" Grid.Row="1" Grid.Column="1" Text="4"/>
                            <TextBlock Grid.Row="2" Text="ItemPadding"/><TextBox x:Name="MenuItemPadding" Grid.Row="2" Grid.Column="1" Text="10,7,10,7"/>
                            <TextBlock Grid.Row="3" Text="BorderThickness"/><TextBox x:Name="MenuBorderThickness" Grid.Row="3" Grid.Column="1" Text="1"/>
                            <TextBlock Grid.Row="4" Text="Tamanho do ícone"/><Slider x:Name="MenuIconSize" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="32" Value="16" ValueChanged="OptionsChanged"/>
                            <TextBlock Grid.Row="5" Text="Largura da coluna do ícone"/><Slider x:Name="MenuIconColumn" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="50" Value="26" ValueChanged="OptionsChanged"/>
                            <TextBlock Grid.Row="6" Text="Opacidade desabilitado"/><Slider x:Name="MenuDisabledOpacity" Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="1" Value="0.45" ValueChanged="OptionsChanged"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="ContextMenu — itens booleano e seletor">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                            <CheckBox x:Name="MenuDetailsValue" Grid.ColumnSpan="2" Content="Valor de Exibir detalhes" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                            <TextBlock Grid.Row="1" Text="Direção do ciclo"/><ComboBox x:Name="MenuChoiceDirection" Grid.Row="1" Grid.Column="1" Margin="6,3" Padding="6" SelectedIndex="0" SelectionChanged="OptionsChanged"><ComboBoxItem Content="Avançar"/><ComboBoxItem Content="Retroceder"/></ComboBox>
                            <CheckBox x:Name="MenuChoiceWrap" Grid.Row="2" Grid.ColumnSpan="2" Content="Reiniciar ao chegar ao fim" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                            <TextBlock Grid.Row="3" Text="Largura da seta"/><Slider x:Name="MenuChoiceArrowWidth" Grid.Row="3" Grid.Column="1" Minimum="12" Maximum="60" Value="24" ValueChanged="OptionsChanged"/>
                            <TextBlock Grid.Row="4" Text="Tema selecionado"/><Slider x:Name="MenuChoiceIndex" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Value="0" ValueChanged="OptionsChanged"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="ContextMenu — cores e sombra">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                            <TextBlock Text="Background"/><DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuBackground}" Foreground="{Binding Text, ElementName=MenuBackground}" Click="PickColor_Click"/><TextBox x:Name="MenuBackground" Text="#35373C"/></DockPanel>
                            <TextBlock Grid.Row="1" Text="Foreground"/><DockPanel Grid.Row="1" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuForeground}" Foreground="{Binding Text, ElementName=MenuForeground}" Click="PickColor_Click"/><TextBox x:Name="MenuForeground" Text="#F2F3F5"/></DockPanel>
                            <TextBlock Grid.Row="2" Text="BorderBrush"/><DockPanel Grid.Row="2" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuBorder}" Foreground="{Binding Text, ElementName=MenuBorder}" Click="PickColor_Click"/><TextBox x:Name="MenuBorder" Text="#4C5058"/></DockPanel>
                            <TextBlock Grid.Row="3" Text="HoverBrush"/><DockPanel Grid.Row="3" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuHover}" Foreground="{Binding Text, ElementName=MenuHover}" Click="PickColor_Click"/><TextBox x:Name="MenuHover" Text="#454850"/></DockPanel>
                            <TextBlock Grid.Row="4" Text="CheckedBrush"/><DockPanel Grid.Row="4" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuChecked}" Foreground="{Binding Text, ElementName=MenuChecked}" Click="PickColor_Click"/><TextBox x:Name="MenuChecked" Text="#9CC9FF"/></DockPanel>
                            <TextBlock Grid.Row="5" Text="SeparatorBrush"/><DockPanel Grid.Row="5" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuSeparator}" Foreground="{Binding Text, ElementName=MenuSeparator}" Click="PickColor_Click"/><TextBox x:Name="MenuSeparator" Text="#4C5058"/></DockPanel>
                            <TextBlock Grid.Row="6" Text="ShadowColor"/><DockPanel Grid.Row="6" Grid.Column="1"><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="{Binding ElementName=MenuShadowColor}" Foreground="{Binding Text, ElementName=MenuShadowColor}" Click="PickColor_Click"/><TextBox x:Name="MenuShadowColor" Text="#494949"/></DockPanel>
                            <CheckBox x:Name="MenuShadow" Grid.Row="7" Grid.ColumnSpan="2" Content="Habilitar sombra" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                            <TextBlock Grid.Row="8" Text="Opacidade / Blur / Depth"/><StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"><Slider x:Name="MenuShadowOpacity" Width="72" Minimum="0" Maximum="1" Value="0.5" ValueChanged="OptionsChanged"/><Slider x:Name="MenuShadowBlur" Width="72" Minimum="0" Maximum="30" Value="10" ValueChanged="OptionsChanged"/><Slider x:Name="MenuShadowDepth" Width="72" Minimum="-15" Maximum="15" Value="0" ValueChanged="OptionsChanged"/></StackPanel>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Restaurar padrões" Click="ResetDefaults_Click"/>
            <Button Content="Aplicar textos e cores" Click="ApplyTextOptions_Click"/>
        </StackPanel>
    </Grid>
</Window>
