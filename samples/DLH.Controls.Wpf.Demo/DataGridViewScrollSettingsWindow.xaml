<Window x:Class="DLH.Controls.Wpf.Demo.DataGridViewScrollSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustar rolagem" Width="500" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#202226" Foreground="#ECEEF2"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Slider"><Setter Property="Minimum" Value="0"/><Setter Property="IsSnapToTickEnabled" Value="True"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="Background" Value="#34373D"/><Setter Property="BorderBrush" Value="#50545C"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Rolagem da roda do mouse" FontSize="21" FontWeight="SemiBold" Foreground="#42A5E8"/>
            <TextBlock Margin="0,5,0,14" Foreground="#AEB3BD" TextWrapping="Wrap"
                       Text="As alterações são aplicadas imediatamente ao DataGridView aberto."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <CheckBox x:Name="SmoothHorizontal" Width="210" Content="Suavizar horizontal" Checked="OptionChanged" Unchecked="OptionChanged"/>
            <CheckBox x:Name="SmoothVertical" Content="Suavizar vertical" Checked="OptionChanged" Unchecked="OptionChanged"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,6,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <TextBlock Text="Passo horizontal"/><Slider x:Name="HorizontalAmount" Grid.Column="1" Minimum="8" Maximum="160" TickFrequency="4" ValueChanged="OptionChanged"/><TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=HorizontalAmount, StringFormat={}{0:0}px}"/>
            <TextBlock Grid.Row="1" Text="Passo vertical"/><Slider x:Name="VerticalAmount" Grid.Row="1" Grid.Column="1" Minimum="8" Maximum="160" TickFrequency="4" ValueChanged="OptionChanged"/><TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=VerticalAmount, StringFormat={}{0:0}px}"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <TextBlock Text="Duração horizontal"/><Slider x:Name="HorizontalDuration" Grid.Column="1" Maximum="500" TickFrequency="10" ValueChanged="OptionChanged"/><TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=HorizontalDuration, StringFormat={}{0:0}ms}"/>
            <TextBlock Grid.Row="1" Text="Duração vertical"/><Slider x:Name="VerticalDuration" Grid.Row="1" Grid.Column="1" Maximum="500" TickFrequency="10" ValueChanged="OptionChanged"/><TextBlock Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Value, ElementName=VerticalDuration, StringFormat={}{0:0}ms}"/>
        </Grid>
        <Border Grid.Row="4" Margin="0,10,0,0" Padding="12" Background="#292B2F" BorderBrush="#45484F" BorderThickness="1" CornerRadius="8">
            <TextBlock Foreground="#AEB3BD" TextWrapping="Wrap" Text="Sugestão para comparar: mantenha o passo vertical em 72 px e teste durações entre 180 e 260 ms. Desative a suavização vertical para distinguir animação de custo de renderização."/>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RestoreDefaults" Content="Restaurar padrões" Click="RestoreDefaults_Click"/>
            <Button Content="Fechar" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
