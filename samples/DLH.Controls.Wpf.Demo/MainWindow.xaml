<Window x:Class="DLH.Controls.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        Title="DLH Controls · Laboratório" Width="1320" Height="820" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Demo.Background}" Foreground="{DynamicResource Tabs.Text}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Demo.Background" Color="#27292E" />
            <SolidColorBrush x:Key="Demo.Accent" Color="#F2F3F5" />
            <SolidColorBrush x:Key="Demo.Input" Color="#27292E" />
            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="{DynamicResource Tabs.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Demo.Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Tabs.Edge}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" CornerRadius="6" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Tabs.Hover}" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Tabs.Focus}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="440" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="150" />
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,22">
            <TextBlock Text="CONTROLES / WPF" FontSize="11" Foreground="{DynamicResource Tabs.Muted}" />
            <TextBlock Text="Um lugar para cada contexto." FontSize="28" FontWeight="SemiBold" Margin="0,6,0,6" />
            <TextBlock Text="Arraste os cabeçalhos para reorganizar. Esc cancela; solte na posição indicada." Foreground="{DynamicResource Tabs.Muted}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,0,20">
            <Button Content="+ Nova aba" Command="{Binding AddTabCommand}" />
            <Button Content="Remover selecionada" Click="CloseSelectedTab" IsEnabled="{Binding CanCloseTabs, ElementName=DynamicTabs}" />
            <Button Content="Configurações das abas" Click="OpenTabSettings" /><Button Content="Alternar tema" Click="ToggleTheme" />
            <Button Content="PT / EN" Click="ToggleLanguage" />
            <Button Content="Título curto / longo" Click="ToggleHeaderLength" />
            <Button Content="Fonte do cabeçalho" Click="ToggleHeaderFont" />
            <Button Content="Mutar coleção em 2s" Click="ScheduleCollectionMutation" />
            <Button Content="Reconstruir coleção" Click="ResetCollection" />
            <Button Content="Salvar configurações" Click="SaveConfiguration" /><Button Content="Restaurar configurações" Click="RestoreConfiguration" /><Button Content="Salvar organização" Click="SaveOrganization" />
            <Button Content="Restaurar organização" Click="RestoreOrganization" />
            <CheckBox Content="Animar" VerticalAlignment="Center" Margin="6,0,12,0" Foreground="{DynamicResource Tabs.Text}" IsChecked="{Binding IsAnimationEnabled, ElementName=DynamicTabs, Mode=OneWay}" Click="ToggleAllAnimation" />
            <CheckBox Content="Permitir exclusão de abas" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Tabs.Text}" IsChecked="{Binding CanCloseTabs, ElementName=DynamicTabs, Mode=OneWay}" Click="ToggleAllClosing" />
            <CheckBox Content="Permitir adição de abas" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Tabs.Text}" IsChecked="{Binding CanAddTabs, ElementName=DynamicTabs, Mode=OneWay}" Click="ToggleAllAdding" />
            <CheckBox Content="Permitir renomear abas" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Tabs.Text}" IsChecked="{Binding CanRenameTabs, ElementName=DynamicTabs, Mode=OneWay}" Click="ToggleAllRenaming" />
            <CheckBox Content="Prévia" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Tabs.Text}" IsChecked="{Binding IsDragPreviewEnabled, ElementName=DynamicTabs, Mode=OneWay}" Click="ToggleAllPreview" />
            <TextBlock x:Name="ThemeName" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource Tabs.Muted}" />
        </WrapPanel>
        <controls:CustomTabControl x:Name="DynamicTabs" ShowCloseButtons="True" ItemKeyPath="Id" CloseTabCommand="{Binding CloseTabCommand}"
                                   CanAddTabs="True" AddTabCommand="{Binding AddTabCommand}" CanRenameTabs="True" TabHeaderPath="Header"
                                   TabClosing="ConfirmTabClosing" TabReordered="OnTabReordered" Grid.Row="2" Margin="0,0,24,0" HeaderIndent="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}">
            <controls:CustomTabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource Tabs.ItemStyle}">
                    <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
                </Style>
            </controls:CustomTabControl.ItemContainerStyle>
            <controls:CustomTabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontSize="{Binding DataContext.HeaderFontSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0" Foreground="{DynamicResource Demo.Accent}" /><TextBlock Text="{Binding Header}" FontSize="{Binding DataContext.HeaderFontSize, RelativeSource={RelativeSource AncestorType=Window}}" /></StackPanel>
                </DataTemplate>
            </controls:CustomTabControl.ItemTemplate>
            <controls:CustomTabControl.ContentTemplate>
                <DataTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Margin="0,10,0,20" Foreground="{DynamicResource Tabs.Muted}" TextWrapping="Wrap" />
                            <TextBlock Text="Anotações" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Padding="12"
                                     Background="{DynamicResource Demo.Input}" Foreground="{DynamicResource Tabs.Text}" BorderBrush="{DynamicResource Tabs.Edge}"
                                     AutomationProperties.Name="Anotações do documento" VerticalScrollBarVisibility="Auto" />
                            <Expander Header="Estado vinculado ao documento" IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Este Expander preserva seu estado porque IsExpanded pertence ao modelo." TextWrapping="Wrap" Foreground="{DynamicResource Tabs.Muted}" Margin="0,0,0,8" />
                                    <TextBlock Text="A rolagem é do apresentador visual compartilhado; não representa uma posição própria de cada documento." TextWrapping="Wrap" Foreground="{DynamicResource Tabs.Muted}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding ExampleLines}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </controls:CustomTabControl.ContentTemplate>
        </controls:CustomTabControl>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.Resources>
                <Style x:Key="SideField" TargetType="TextBox">
                    <Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,4,0,10" />
                    <Setter Property="Background" Value="{DynamicResource Demo.Input}" /><Setter Property="Foreground" Value="{DynamicResource Tabs.Text}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Tabs.Edge}" />
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <ComboBox DockPanel.Dock="Right" Width="100" SelectedValuePath="Tag" SelectedValue="{Binding TabStripPlacement, ElementName=SideTabs, Mode=TwoWay}">
                    <ComboBoxItem Content="Esquerda" Tag="{x:Static Dock.Left}" />
                    <ComboBoxItem Content="Direita" Tag="{x:Static Dock.Right}" />
                </ComboBox>
                <StackPanel><TextBlock Text="Painel de demonstraÃ§Ã£o" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="MODELO LATERAL" FontSize="10" Foreground="{DynamicResource Tabs.Muted}" Margin="0,4,0,0" /></StackPanel>
            </DockPanel>
            <controls:CustomTabControl x:Name="SideTabs" Grid.Row="1" TabStripPlacement="Left" HeaderIndent="0" CornerRadius="10" Padding="18" TabDragCursor="ScrollNS" SelectedIndex="0"
                                       CanAddTabs="True" CanRenameTabs="True" AddTabRequested="AddSideTab">
                <controls:CustomTabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource Tabs.ItemStyle}"><Setter Property="Padding" Value="7" /></Style>
                </controls:CustomTabControl.ItemContainerStyle>
                <controls:CustomTabItem controls:CustomTabControl.TabKey="Licença" ToolTip="Licença" AutomationProperties.Name="Licença">
                    <controls:CustomTabItem.Header><Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource Demo.Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M4,2 H16 L21,7 V22 H4 Z M16,2 V7 H21 M8,12 H17 M8,16 H17" /></controls:CustomTabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Licença" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="CNPJ" /><TextBox Style="{StaticResource SideField}" Text="00.000.000/0001-00" />
                        <TextBlock Text="Licença" /><TextBox Style="{StaticResource SideField}" Text="DEMONSTRAÇÃO" />
                        <TextBlock Text="Razão social" /><TextBox Style="{StaticResource SideField}" Text="EMPRESA DE EXEMPLO" />
                        <TextBlock Text="Fantasia" /><TextBox Style="{StaticResource SideField}" Text="aplicaÃ§Ã£o de demonstraÃ§Ã£o" />
                    </StackPanel></ScrollViewer>
                </controls:CustomTabItem>
                <controls:CustomTabItem controls:CustomTabControl.TabKey="Banco de dados" ToolTip="Banco de dados" AutomationProperties.Name="Banco de dados">
                    <controls:CustomTabItem.Header><Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource Demo.Accent}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M3,5 C3,1 21,1 21,5 V19 C21,23 3,23 3,19 Z M3,5 C3,9 21,9 21,5 M3,12 C3,16 21,16 21,12" /></controls:CustomTabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Banco de dados" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Servidor" /><TextBox Style="{StaticResource SideField}" Text="LOCALHOST" />
                        <TextBlock Text="Banco de dados" /><TextBox Style="{StaticResource SideField}" Text="C:\Dados\EXEMPLO.FDB" />
                        <TextBlock Text="Usuário" /><TextBox Style="{StaticResource SideField}" Text="Usuário de exemplo" />
                        <TextBlock Text="Dados ilustrativos; nenhuma conexão é realizada." TextWrapping="Wrap" Foreground="{DynamicResource Tabs.Muted}" />
                    </StackPanel></ScrollViewer>
                </controls:CustomTabItem>
                <controls:CustomTabItem controls:CustomTabControl.TabKey="Procedimentos" ToolTip="Procedimentos" AutomationProperties.Name="Procedimentos">
                    <controls:CustomTabItem.Header><Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource Demo.Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,3 H20 V21 H4 Z M8,8 L10,10 L14,6 M8,15 H17 M8,18 H15" /></controls:CustomTabItem.Header>
                    <StackPanel><TextBlock Text="Procedimentos" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBox Style="{StaticResource SideField}" AcceptsReturn="True" MinHeight="140" Text="Consultar terminal&#10;Validar produto&#10;Criar comanda&#10;Adicionar item" />
                        <TextBlock Text="Arraste os ícones para reorganizar as páginas." TextWrapping="Wrap" Foreground="{DynamicResource Tabs.Muted}" />
                    </StackPanel>
                </controls:CustomTabItem>
                <controls:CustomTabItem controls:CustomTabControl.TabKey="Informações" ToolTip="Informações" AutomationProperties.Name="Informações">
                    <controls:CustomTabItem.Header><Path Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource Demo.Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2 A10,10 0 1 1 11.99,2 M12,10 V18 M12,6 V7" /></controls:CustomTabItem.Header>
                    <StackPanel><TextBlock Text="Informações" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Painel de demonstraÃ§Ã£o" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                        <TextBlock Text="Exemplo de navegação lateral com os quatro ícones fornecidos. O contorno e a sombra acompanham a aba selecionada." TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="Use o tema Cinza e laranja para comparar com a referência." TextWrapping="Wrap" Foreground="{DynamicResource Tabs.Muted}" />
                    </StackPanel>
                </controls:CustomTabItem>
            </controls:CustomTabControl>
        </Grid>
        <TextBlock x:Name="InteractionStatus" Grid.ColumnSpan="2" Grid.Row="3" Text="Os controles superior e inferior compartilham documentos e ordem, mas mantêm seleções independentes." Margin="0,22,0,12" FontSize="11" Foreground="{DynamicResource Tabs.Muted}" />
        <controls:CustomTabControl x:Name="SimpleTabs" Grid.ColumnSpan="2" Grid.Row="4" Padding="18" HeaderIndent="0" TabSpacing="0" CornerRadius="8"
                                   ItemsSource="{Binding Tabs}" SelectedItem="{Binding ComparisonSelectedTab, Mode=TwoWay}" ItemKeyPath="Id" CloseTabCommand="{Binding CloseTabCommand}"
                                   CanAddTabs="True" AddTabCommand="{Binding AddTabCommand}" CanRenameTabs="True" TabHeaderPath="Header">
            <controls:CustomTabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource Tabs.ItemStyle}"><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /><Setter Property="AutomationProperties.Name" Value="{Binding Header}" /></Style>
            </controls:CustomTabControl.ItemContainerStyle>
            <controls:CustomTabControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Header}" /></DataTemplate>
            </controls:CustomTabControl.ItemTemplate>
            <controls:CustomTabControl.ContentTemplate>
                <DataTemplate><TextBlock Text="{Binding Header, StringFormat=Seleção independente: {0}}" TextWrapping="Wrap" /></DataTemplate>
            </controls:CustomTabControl.ContentTemplate>
        </controls:CustomTabControl>
    </Grid>
</Window>
