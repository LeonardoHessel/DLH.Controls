<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DLH.Controls.Wpf</PackageId>
    <Version>0.2.0-preview.4</Version>
    <Authors>Leonardo D. de L. Hessel</Authors>
    <Description>Controles reutilizáveis para WPF, incluindo TabControl, DataGridView, ScrollBar e ContextMenu personalizáveis.</Description>
    <PackageTags>WPF;Controls;TabControl;DataGrid;DataGridView;ScrollBar;ContextMenu;Windows;Paket</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <Copyright>Copyright © 2026 Leonardo D. de L. Hessel</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/LeonardoHessel/DLH.Controls</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LeonardoHessel/DLH.Controls.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup><None Include="..\..\README.md" Pack="true" PackagePath="\" /><None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" /></ItemGroup>
</Project>
