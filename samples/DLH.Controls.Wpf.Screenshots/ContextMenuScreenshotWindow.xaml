<Window x:Class="DLH.Controls.Wpf.Screenshots.ContextMenuScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        Title="ContextMenu" Width="900" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1C1D20" Foreground="#ECEEF2"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="RefreshIcon">M2,8 A6,6 0 1 0 4,3 M4,1 L4,4 L7,4</Geometry>
            <Geometry x:Key="DarkThemeIcon">M11,2 A6,6 0 1 0 14,12 A5,5 0 0 1 11,2</Geometry>
            <Geometry x:Key="LightThemeIcon">M8,3 A5,5 0 1 0 8.01,3 M8,0 L8,2 M8,14 L8,16 M0,8 L2,8 M14,8 L16,8</Geometry>
            <Geometry x:Key="SystemThemeIcon">M8,2 A6,6 0 1 0 8,14 L8,2</Geometry>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <TextBlock Text="ContextMenu" Margin="60,48,0,0" FontSize="26" FontWeight="SemiBold" Foreground="#42A5E8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBlock Text="Ações contextuais com ícones, valores, atalhos e submenus alinhados." Margin="60,86,0,0" Foreground="#AEB3BD" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Border x:Name="TargetArea" Width="360" Height="210" Margin="60,170,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#292B2F" BorderBrush="#45484F" BorderThickness="1" CornerRadius="12">
            <Border.ContextMenu>
                <controls:ContextMenu x:Name="Menu" CornerRadius="10" ItemPadding="12,8" IconColumnWidth="28"
                                      IsShadowEnabled="False" Placement="Bottom"
                                      PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Border}}">
                    <MenuItem Header="Atualizar" InputGestureText="F5" Icon="{StaticResource RefreshIcon}"/>
                    <controls:ToggleMenuItem Header="Exibir detalhes" IsChecked="True">
                        <controls:ToggleMenuItem.CheckedIcon><Ellipse Width="8" Height="8" Fill="#7EDC9A"/></controls:ToggleMenuItem.CheckedIcon>
                        <controls:ToggleMenuItem.UncheckedIcon><Ellipse Width="8" Height="8" Stroke="#AEB3BD" StrokeThickness="1.5"/></controls:ToggleMenuItem.UncheckedIcon>
                    </controls:ToggleMenuItem>
                    <controls:ChoiceMenuItem Header="Tema" SelectedIndex="0">
                        <controls:ChoiceMenuOption Content="Escuro" Value="Dark" Icon="{StaticResource DarkThemeIcon}"/>
                        <controls:ChoiceMenuOption Content="Claro" Value="Light" Icon="{StaticResource LightThemeIcon}"/>
                        <controls:ChoiceMenuOption Content="Sistema" Value="System" Icon="{StaticResource SystemThemeIcon}"/>
                    </controls:ChoiceMenuItem>
                    <Separator/>
                    <MenuItem Header="Fixar registro" IsCheckable="True"/>
                    <MenuItem Header="Exportar" x:Name="ExportItem">
                        <MenuItem Header="Arquivo CSV"/>
                        <MenuItem Header="Planilha" IsEnabled="False"/>
                        <MenuItem Header="PDF"/>
                    </MenuItem>
                </controls:ContextMenu>
            </Border.ContextMenu>
            <Grid Margin="22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="EMB-2206" FontSize="19" FontWeight="SemiBold" Foreground="#ECEEF2"/>
                <TextBlock Grid.Row="1" Margin="0,5,0,0" Text="Guarulhos  →  Blumenau" Foreground="#AEB3BD"/>
                <TextBlock Grid.Row="2" Margin="0,18,0,0" Text="Divergência de peso em conferência." TextWrapping="Wrap" Foreground="#C8CBD2"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Border Padding="8,3" CornerRadius="8" Background="#35A93D4A" BorderBrush="#8C4C55" BorderThickness="1">
                        <TextBlock Text="Pendente" Foreground="#FF929A" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Margin="12,2,0,0" Text="Clique com o botão direito" Foreground="#8D939E" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

