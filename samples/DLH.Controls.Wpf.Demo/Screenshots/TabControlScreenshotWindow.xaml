<Window x:Class="DLH.Controls.Wpf.Demo.Screenshots.TabControlScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlh="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        xmlns:local="clr-namespace:DLH.Controls.Wpf.Demo.Screenshots"
        Title="TabControl" Width="1320" Height="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1C1D20" Foreground="#ECEEF2"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C1D20"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
        <DataTemplate x:Key="PageContent">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="#42A5E8"/>
                <TextBlock Margin="0,8,0,0" Text="{Binding Description}" Foreground="#AEB3BD" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <UniformGrid Columns="2" Rows="2" Margin="24">
        <Border Style="{StaticResource Card}">
            <dlh:TabControl TabStripPlacement="Top" CornerRadius="12" TabSpacing="16" HeaderIndent="16" SelectedIndex="0">
                <dlh:TabControlItem>
                    <dlh:TabControlItem.Header>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Margin="0,0,8,0" Foreground="#42A5E8"/><TextBlock Text="Visão geral"/></StackPanel>
                    </dlh:TabControlItem.Header>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Overview}"/>
                </dlh:TabControlItem>
                <dlh:TabControlItem Header="Editor"/>
                <dlh:TabControlItem Header="Indisponível" IsEnabled="False"/>
            </dlh:TabControl>
        </Border>
        <Border Style="{StaticResource Card}">
            <dlh:TabControl TabStripPlacement="Bottom" CornerRadius="12" TabSpacing="16" HeaderIndent="16" SelectedIndex="1">
                <dlh:TabControlItem Header="Visão geral"/>
                <dlh:TabControlItem>
                    <dlh:TabControlItem.Header>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="✎" Margin="0,0,8,0" Foreground="#42A5E8"/><TextBlock Text="Editor"/></StackPanel>
                    </dlh:TabControlItem.Header>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Editor}"/>
                </dlh:TabControlItem>
                <dlh:TabControlItem Header="Indisponível" IsEnabled="False"/>
            </dlh:TabControl>
        </Border>
        <Border Style="{StaticResource Card}">
            <dlh:TabControl TabStripPlacement="Left" CornerRadius="12" TabSpacing="8" SelectedIndex="0">
                <dlh:TabControlItem Header="Visão geral">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Overview}"/>
                </dlh:TabControlItem>
                <dlh:TabControlItem Header="Editor"/>
                <dlh:TabControlItem Header="Config."/>
            </dlh:TabControl>
        </Border>
        <Border Style="{StaticResource Card}">
            <dlh:TabControl TabStripPlacement="Right" CornerRadius="12" TabSpacing="8" SelectedIndex="2">
                <dlh:TabControlItem Header="Visão geral"/>
                <dlh:TabControlItem Header="Editor"/>
                <dlh:TabControlItem Header="Config.">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Settings}"/>
                </dlh:TabControlItem>
            </dlh:TabControl>
        </Border>
    </UniformGrid>
</Window>
