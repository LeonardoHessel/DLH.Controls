<Window x:Class="DLH.Controls.Wpf.Demo.DataGridViewDemoWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
 Title="DLH Controls · DataGridView" Width="1120" Height="720" MinWidth="820" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="#1C1D20" Foreground="#ECEEF2" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SummaryCard" TargetType="Border"><Setter Property="Background" Value="#292B2F"/><Setter Property="BorderBrush" Value="#45484F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18,14"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="Background" Value="#34373D"/><Setter Property="BorderBrush" Value="#50545C"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D6D8DE"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,14,0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="28,22,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Resumo de inspeções" FontSize="28" FontWeight="SemiBold" Foreground="#42A5E8"/><TextBlock Margin="0,4,0,0" Foreground="#AEB3BD" Text="Tabela compacta com ordenação, seleção, colunas configuráveis e estados de dados."/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Configurar controles" Click="OpenSharedControlsDemo_Click"/>
    <Button Content="Menu de opções">
     <Button.ContextMenu>
      <controls:ContextMenu CornerRadius="8" ItemPadding="12,8" IconColumnWidth="28">
       <MenuItem Header="Atualizar" InputGestureText="F5"><MenuItem.Icon><TextBlock Text="↻" Foreground="#42A5E8"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="Exibir detalhes" IsCheckable="True" IsChecked="True"/>
       <Separator/>
       <MenuItem Header="Exportar">
        <MenuItem Header="Arquivo CSV"/>
        <MenuItem Header="Planilha" IsEnabled="False"/>
       </MenuItem>
      </controls:ContextMenu>
     </Button.ContextMenu>
    </Button>
    <Button Content="Abrir exemplo de abas" Click="OpenTabsDemo_Click"/>
   </StackPanel>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,18">
   <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="INSPECIONADOS" Foreground="#9DA3AE" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="1174" FontSize="24" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource SummaryCard}"><StackPanel><TextBlock Text="RESOLVIDAS" Foreground="#9DA3AE" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="2" FontSize="24" Margin="0,4,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource SummaryCard}" Margin="0"><StackPanel><TextBlock Text="PENDENTES" Foreground="#FF7777" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="4" Foreground="#FF7777" FontSize="24" Margin="0,4,0,0"/></StackPanel></Border>
  </UniformGrid>
  <WrapPanel Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="Seleção" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AEB3BD"/>
   <ComboBox x:Name="SelectionSelector" Width="125" SelectedIndex="1" SelectionChanged="SelectionSelector_SelectionChanged"><ComboBoxItem Content="Nenhuma" Tag="None"/><ComboBoxItem Content="Linha" Tag="Row"/><ComboBoxItem Content="Coluna" Tag="Column"/><ComboBoxItem Content="Célula" Tag="Cell"/></ComboBox>
   <TextBlock Text="Densidade" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="#AEB3BD"/><ComboBox x:Name="DensitySelector" Width="130" SelectedIndex="0" SelectionChanged="DensitySelector_SelectionChanged"><ComboBoxItem Content="Compacta" Tag="Compact"/><ComboBoxItem Content="Padrão" Tag="Default"/><ComboBoxItem Content="Confortável" Tag="Comfortable"/></ComboBox>
   <TextBlock Text="Barra" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="#AEB3BD"/><Slider x:Name="ScrollBarThicknessSlider" Width="90" Minimum="6" Maximum="20" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ScrollBarThicknessSlider_ValueChanged" VerticalAlignment="Center"/><TextBlock Width="34" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#D6D8DE" Text="{Binding Value, ElementName=ScrollBarThicknessSlider, StringFormat={}{0:0}px}"/>
   <CheckBox x:Name="GroupRows" Margin="18,0,14,0" Content="Agrupar por status" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="ShowDetails" Content="Detalhes" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="EnableEditing" Margin="18,0,14,0" Content="Editar células" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="MultipleSelection" Margin="18,0,14,0" Content="Seleção múltipla" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="EnableSorting" Margin="18,0,14,0" Content="Ordenar" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="MultiColumnSort" Content="Ordenação múltipla" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="ReorderColumns" Content="Reordenar" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="ColumnMenu" Content="Menu de colunas" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="StripedRows" Content="Linhas alternadas" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
  </WrapPanel>
  <WrapPanel Grid.Row="3" Margin="0,0,0,12"><TextBox x:Name="FilterText" Width="180" Padding="8,6" Margin="0,0,8,0" ToolTip="Filtrar por número do embarque" TextChanged="FilterText_Changed"/><Button Content="Limpar filtro" Click="ClearFilter_Click"/><Button Content="Adicionar" Click="AddRow_Click"/><Button Content="Remover selecionada" Click="RemoveSelected_Click"/><Button Content="Processar seleção" Click="ProcessSelected_Click"/><Button Content="Exportar CSV" Click="ExportCsv_Click"/><Button Content="Salvar layout" Click="SaveLayout_Click"/><Button Content="Restaurar layout" Click="LoadLayout_Click"/><Button Content="Layout inicial" Click="ResetLayout_Click"/><Button Content="Exibir colunas" Click="RestoreColumns_Click"/><Button Content="Carregando" Click="ToggleLoading_Click"/><Button Content="Alternar vazio" Click="ToggleEmpty_Click"/><Button Content="Alternar erro" Click="ToggleError_Click"/><CheckBox x:Name="ShowClearSort" Content="Menu limpar" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/><CheckBox x:Name="ShowRestoreSort" Content="Menu restaurar" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged"/></WrapPanel>
  <controls:DataGridView x:Name="ShipmentsGrid" Grid.Row="4" ItemsSource="{Binding Rows}" SelectionBehavior="Row" SelectionChangedCommand="{Binding SelectionCommand}" Density="Compact" CornerRadius="10" CanUserReorderColumns="True" CanUserToggleColumnVisibility="True" ShowRowSeparators="True" DefaultSortMemberPath="Shipment" DefaultSortDirection="Ascending" EmptyMessage="Nenhuma inspeção encontrada." LoadingMessage="Carregando inspeções...">
   <controls:DataGridView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#34373D" Padding="12,7"><TextBlock Text="{Binding Name, StringFormat=Status: {0}}" FontWeight="SemiBold" Foreground="#8DCAEF"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></controls:DataGridView.GroupStyle>
   <controls:DataGridView.RowDetailsTemplate><DataTemplate><Border Margin="16,2,16,8" Padding="12,8" Background="#292B2F" CornerRadius="6"><TextBlock Text="{Binding Notes}" Foreground="#AEB3BD"/></Border></DataTemplate></controls:DataGridView.RowDetailsTemplate>
   <DataGridTextColumn Header="Nº Embarque" Binding="{Binding Shipment}" SortMemberPath="Shipment" MinWidth="160" Width="2*"/><DataGridTextColumn Header="Origem" Binding="{Binding Origin}" SortMemberPath="Origin" MinWidth="105" Width="*"/><DataGridTextColumn Header="Veículo" Binding="{Binding Vehicle}" SortMemberPath="Vehicle" MinWidth="125" Width="*"/><DataGridTextColumn Header="Quantidade" Binding="{Binding Quantity}" SortMemberPath="Quantity" MinWidth="90" Width="*"/><DataGridTextColumn Header="Inspecionados" Binding="{Binding Inspected}" SortMemberPath="Inspected" MinWidth="110" Width="*"/>
   <DataGridTemplateColumn Header="Status" SortMemberPath="Status" MinWidth="135" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="Badge" HorizontalAlignment="Left" Padding="8,3" CornerRadius="8" Background="#253E566B" BorderBrush="#536B7F" BorderThickness="1"><TextBlock x:Name="BadgeText" Text="{Binding Status}" Foreground="#8DCAEF" FontSize="12" FontWeight="SemiBold"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Status}" Value="Pendente"><Setter TargetName="Badge" Property="Background" Value="#35A93D4A"/><Setter TargetName="Badge" Property="BorderBrush" Value="#8C4C55"/><Setter TargetName="BadgeText" Property="Foreground" Value="#FF929A"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Concluído"><Setter TargetName="Badge" Property="Background" Value="#294A4034"/><Setter TargetName="Badge" Property="BorderBrush" Value="#4B725A"/><Setter TargetName="BadgeText" Property="Foreground" Value="#8DD5A1"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" SortMemberPath="Destination" MinWidth="150" Width="*"/>
   <DataGridTextColumn Header="Doca" Binding="{Binding Dock}" SortMemberPath="Dock" MinWidth="85" Width="Auto"/>
   <DataGridTextColumn Header="Inspetor" Binding="{Binding Inspector}" SortMemberPath="Inspector" MinWidth="155" Width="*"/>
   <DataGridTextColumn Header="Última atualização" Binding="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" SortMemberPath="UpdatedAt" MinWidth="175" Width="Auto"/>
   <DataGridTextColumn Header="Observação" Binding="{Binding Notes}" SortMemberPath="Notes" MinWidth="240" Width="2*"/>
  </controls:DataGridView>
  <TextBlock x:Name="StatusText" Grid.Row="5" Margin="2,12,0,0" Foreground="#AEB3BD" Text="Shift+clique adiciona critérios; Ctrl+clique remove um critério."/>
 </Grid>
</Window>

