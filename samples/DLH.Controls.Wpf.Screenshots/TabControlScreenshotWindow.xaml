<Window x:Class="DLH.Controls.Wpf.Screenshots.TabControlScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlh="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        xmlns:local="clr-namespace:DLH.Controls.Wpf.Screenshots"
        Title="TabControl" Width="1320" Height="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1C1D20" Foreground="#ECEEF2"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SpaciousTabItem" TargetType="TabItem" BasedOn="{StaticResource Tabs.ItemStyle}">
                <Setter Property="Padding" Value="18,10"/>
            </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#24262B"/>
            <Setter Property="BorderBrush" Value="#3F4249"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB3BD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,4,10"/>
        </Style>
        <DataTemplate x:Key="PageContent">
            <StackPanel Margin="20">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="#42A5E8"/>
                <TextBlock Margin="0,8,0,0" Text="{Binding Description}" Foreground="#C3C7CF" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="8,0,8,12">
            <TextBlock Text="TabControl" FontSize="26" FontWeight="SemiBold" Foreground="#42A5E8"/>
            <TextBlock Margin="0,4,0,0" Foreground="#AEB3BD" Text="A mesma superfície contínua com abas superiores, inferiores e laterais."/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="2" Rows="2">
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ABAS SUPERIORES"/>
                    <dlh:TabControl Grid.Row="1" Margin="8" TabStripPlacement="Top" CornerRadius="12" TabSpacing="6" HeaderIndent="22" ItemContainerStyle="{StaticResource SpaciousTabItem}" SelectedIndex="0" Background="#292B2F" BorderBrush="#4A4E56">
                        <dlh:TabControlItem>
                            <dlh:TabControlItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Margin="0,0,8,0" Foreground="#42A5E8"/><TextBlock Text="Visão geral"/></StackPanel></dlh:TabControlItem.Header>
                            <ContentControl ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Overview}" Content="{Binding}"/>
                        </dlh:TabControlItem>
                        <dlh:TabControlItem Header="Editor"/>
                        <dlh:TabControlItem Header="Indisponível" IsEnabled="False"/>
                    </dlh:TabControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ABAS INFERIORES"/>
                    <dlh:TabControl Grid.Row="1" Margin="8" TabStripPlacement="Bottom" CornerRadius="12" TabSpacing="6" HeaderIndent="22" ItemContainerStyle="{StaticResource SpaciousTabItem}" SelectedIndex="1" Background="#292B2F" BorderBrush="#4A4E56">
                        <dlh:TabControlItem Header="Visão geral"/>
                        <dlh:TabControlItem>
                            <dlh:TabControlItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="✎" Margin="0,0,8,0" Foreground="#42A5E8"/><TextBlock Text="Editor"/></StackPanel></dlh:TabControlItem.Header>
                            <ContentControl ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Editor}" Content="{Binding}"/>
                        </dlh:TabControlItem>
                        <dlh:TabControlItem Header="Indisponível" IsEnabled="False"/>
                    </dlh:TabControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ABAS À ESQUERDA"/>
                    <dlh:TabControl Grid.Row="1" Margin="8" TabStripPlacement="Left" CornerRadius="12" TabSpacing="6" HeaderIndent="18" ItemContainerStyle="{StaticResource SpaciousTabItem}" SelectedIndex="0" Background="#292B2F" BorderBrush="#4A4E56">
                        <dlh:TabControlItem Header="Visão geral"><ContentControl ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Overview}" Content="{Binding}"/></dlh:TabControlItem>
                        <dlh:TabControlItem Header="Editor"/>
                        <dlh:TabControlItem Header="Config."/>
                    </dlh:TabControl>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="ABAS À DIREITA"/>
                    <dlh:TabControl Grid.Row="1" Margin="8" TabStripPlacement="Right" CornerRadius="12" TabSpacing="6" HeaderIndent="18" ItemContainerStyle="{StaticResource SpaciousTabItem}" SelectedIndex="2" Background="#292B2F" BorderBrush="#4A4E56">
                        <dlh:TabControlItem Header="Visão geral"/>
                        <dlh:TabControlItem Header="Editor"/>
                        <dlh:TabControlItem Header="Config."><ContentControl ContentTemplate="{StaticResource PageContent}" DataContext="{x:Static local:Pages.Settings}" Content="{Binding}"/></dlh:TabControlItem>
                    </dlh:TabControl>
                </Grid>
            </Border>
        </UniformGrid>
    </Grid>
</Window>
