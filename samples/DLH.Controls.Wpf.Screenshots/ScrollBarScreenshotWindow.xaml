<Window x:Class="DLH.Controls.Wpf.Screenshots.ScrollBarScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DLH.Controls.Wpf;assembly=DLH.Controls.Wpf"
        Title="ScrollBar" Width="1100" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1C1D20" Foreground="#ECEEF2"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DLH.Controls.Wpf;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="32,26,32,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="ScrollBar" FontSize="26" FontWeight="SemiBold" Foreground="#42A5E8"/>
            <TextBlock Margin="0,4,0,0" Foreground="#AEB3BD"
                       Text="As barras horizontal e vertical controlam a mesma área de conteúdo."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="4,0,0,14">
            <TextBlock Text="Conteúdo maior que a área visível" FontSize="19" FontWeight="SemiBold" Foreground="#ECEEF2"/>
            <TextBlock Margin="0,5,0,0" Foreground="#8DCAEF"
                       Text="Use os indicadores, as trilhas ou os botões direcionais para navegar nos dois eixos."/>
        </StackPanel>
        <Border Grid.Row="2" Background="#202226" BorderBrush="#45484F" BorderThickness="1" CornerRadius="12" Padding="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <ScrollViewer x:Name="TextViewport" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="False" Padding="14">
                    <Grid Width="1420" Height="820">
                        <StackPanel>
                                <TextBlock Width="1320" HorizontalAlignment="Left" Foreground="#C9CDD5" FontSize="18" LineHeight="32" TextWrapping="Wrap">
                                    <Run Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. "/>
                                    <Run Text="Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. "/>
                                    <Run Text="Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. "/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="Esta composição mantém um conteúdo deliberadamente largo e alto. Assim, a barra horizontal oferece os mesmos recursos da vertical e ambas podem ser avaliadas ao mesmo tempo. "/>
                                    <Run Text="A espessura, as cores, o raio, a sombra e os botões são configurados com os mesmos valores para deixar a equivalência visual evidente. "/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. "/>
                                    <Run Text="Curabitur pretium tincidunt lacus, nulla gravida orci a odio, nullam varius turpis et commodo pharetra. "/>
                                    <Run Text="Donec accumsan malesuada orci, donec sit amet eros, lorem ipsum dolor sit amet. "/>
                                    <LineBreak/><LineBreak/>
                                    <Run Text="Role até as extremidades para verificar o tamanho do indicador conforme a área visível, o limite do movimento e o arredondamento das pontas. "/>
                                    <Run Text="O conteúdo continua além do limite inicial tanto para a direita quanto para baixo."/>
                                </TextBlock>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <controls:ScrollBar x:Name="VerticalBar" Grid.Column="1" Orientation="Vertical"
                                    Thickness="14" CornerRadius="7" Margin="10,0,0,0"
                                    ShowButtons="True" IsShadowEnabled="True"
                                    TrackBrush="#1D1F23" ThumbBrush="#42A5E8"
                                    ThumbHoverBrush="#68B9EE" ThumbPressedBrush="#86C9F3"/>

                <controls:ScrollBar x:Name="HorizontalBar" Grid.Row="1" Orientation="Horizontal"
                                    Thickness="14" CornerRadius="7" Margin="0,10,0,0"
                                    ShowButtons="True" IsShadowEnabled="True"
                                    TrackBrush="#1D1F23" ThumbBrush="#42A5E8"
                                    ThumbHoverBrush="#68B9EE" ThumbPressedBrush="#86C9F3"/>

                <Border Grid.Row="1" Grid.Column="1" Width="14" Height="14" Margin="10,10,0,0" Background="#202226"/>
            </Grid>
        </Border>
    </Grid>
</Window>
